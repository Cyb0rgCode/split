# ── Pick ONE provider (Gemini is checked first) ──────────────────────────────

# Google Gemini — free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-3.1-flash-lite — most generous free-tier limits)
GEMINI_MODEL=

# NVIDIA NIM — free credits, get a key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# Optional override (default: meta/llama-3.3-70b-instruct)
NVIDIA_NIM_MODEL=
