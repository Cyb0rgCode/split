# ── Pick ONE provider (Gemini is checked first) ──────────────────────────────

# Google Gemini — free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-3.1-flash-lite — most generous free-tier limits)
GEMINI_MODEL=
# Spoken corrections use Gemini TTS (free tier: ~10/day per model) with
# automatic fallback to browser speech synthesis. Optional overrides:
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

# ── ElevenLabs TTS (optional, free — best voice quality) ─────────────────────
# Free plan: 10,000 credits/month with API access (~0.5 credit/character on
# the flash model). Get a key at https://elevenlabs.io/app/developers
# When set, it is tried before Gemini TTS.
ELEVENLABS_API_KEY=
# Optional overrides (defaults: Rachel voice, eleven_flash_v2_5)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# NVIDIA NIM — free credits, get a key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# Optional override (default: meta/llama-3.3-70b-instruct)
NVIDIA_NIM_MODEL=

# ── Web search for live sources (all optional) ───────────────────────────────
# Fact-check cards cite a live search result instead of the model's memory.
# Without any key, the app falls back to the keyless Wikipedia search API.

# Tavily — free 1,000 credits/month, https://tavily.com
TAVILY_API_KEY=
